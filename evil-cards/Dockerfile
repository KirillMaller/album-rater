# ============================================================================
#  Злобные карты — образ для сервера (VPS Aeza, Германия).
#
#  Собирается через docker-compose.yml, который задаёт лимит памяти 256 МБ.
#  Внутри Node ограничен флагом --max-old-space-size=192: так сборщик мусора
#  начнёт чистить heap ЗАРАНЕЕ и процесс не словит OOM-kill от лимита cgroup.
#  Без этого флага Node считает, что памяти столько же, сколько на всей машине,
#  раздувает heap и его молча убивает ядро — контейнер уходит в рестарт-петлю.
# ============================================================================
FROM node:20-alpine

WORKDIR /app

# --- Слой 1: зависимости ----------------------------------------------------
# Копируем только манифесты. Этот слой пересобирается ТОЛЬКО когда меняется
# package.json / package-lock.json — правки кода не заставляют качать npm заново.
COPY package*.json ./

# npm ci ставит строго то, что зафиксировано в package-lock.json.
# Если lock-файла в репозитории нет (его забыли закоммитить) — npm ci падает,
# поэтому здесь есть запасной npm install, чтобы деплой не встал колом.
# Правильный путь: один раз локально сделать `npm install` и закоммитить
# package-lock.json — тогда на сервере встанут ровно те же версии.
RUN npm ci --omit=dev \
    || npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force

# --- Слой 2: код ------------------------------------------------------------
# Что именно сюда попадёт — смотри .dockerignore (public/ и server/ обязательны,
# data/ намеренно исключена: она приезжает томом с хоста).
COPY . .

# --- Каталог данных ---------------------------------------------------------
# Сюда монтируется том ./data:/app/data (state.json + база карт).
# Создаём и внутри образа, чтобы контейнер поднимался даже без тома,
# и отдаём права пользователю node — от него будет работать процесс.
RUN mkdir -p /app/data && chown -R node:node /app/data

ENV NODE_ENV=production \
    PORT=3000

# Не работаем от root: если игру ломанут, злоумышленник окажется
# непривилегированным пользователем внутри контейнера.
USER node

EXPOSE 3000

# Проверка живости. В alpine нет curl, но есть wget из busybox.
# Эндпоинт /health отдаёт 200, когда сервер поднялся и держит состояние.
# start-period=15s — даём время прочитать data/state.json на старте.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT:-3000}/health" || exit 1

# Запускаем node напрямую, без npm — на один процесс меньше и на ~30 МБ
# меньше памяти. Правильную обработку сигналов даёт init: true в compose.
CMD ["node", "--max-old-space-size=192", "server/index.js"]
