# ── Настройки запуска «Злобных карт» ────────────────────────────────────────
# Скопируй этот файл в .env и правь его. Сам .env в git не попадает.

# Порт, на котором слушает игра. Если 3000 занят — поменяй только здесь,
# docker-compose.yml подставит этот же порт автоматически.
PORT=3000

# Адрес, который попадёт в QR-код.
#
# НА НОУТБУКЕ в локальной Wi-Fi — оставить пустым. Сервер сам определит IP
# и напечатает его при запуске.
#
# НА СЕРВЕРЕ Aeza — раскомментировать строку ниже. Это готовый адрес для
# IP 109.172.94.130 через sslip.io (авто-DNS, регистрировать ничего не надо).
# PUBLIC_URL=https://109-172-94-130.sslip.io
