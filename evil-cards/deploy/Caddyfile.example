# ============================================================================
#  Злобные карты — блок для Caddy.
#
#  >>> НА СЕРВЕРЕ AEZA (109.172.94.130) ЭТОТ ФАЙЛ НЕ НУЖЕН. <<<
#  Там Caddy не установлен, зато работает nginx (порты 8443/8444 — чужие
#  сайты). Ставить Caddy рядом с nginx не надо: два веб-сервера будут драться
#  за 80/443, а память на машине и так на исходе. Бери deploy/nginx.example.conf.
#  Этот файл — для случая, когда игру ставят на ДРУГУЮ машину, где на 80/443
#  уже стоит Caddy.
#
#  IP 109.172.94.130 ниже — реальный адрес сервера Aeza, а не заглушка.
#  На другой машине замени его — везде в этом файле.
#  Домен игры собирается из IP: <IP-сервера>.sslip.io. sslip.io это авто-DNS,
#  он резолвит такое имя обратно в этот же IP. Регистрировать ничего не надо,
#  Let's Encrypt подтверждает такой домен как обычный.
#  Узнать IP:  curl -s https://api.ipify.org   или   bash deploy/check-server.sh
#
#  Замен ровно две:
#    1) здесь, 109-172-94-130.sslip.io
#    2) в .env проекта: PUBLIC_URL=https://109-172-94-130.sslip.io
#
#  ВНИМАНИЕ: на сервере уже работают сайт, бот и VPN. Ничего в чужих блоках
#  НЕ править — просто добавить этот блок в конец файла (см. низ файла).
# ============================================================================

109-172-94-130.sslip.io {
	# HTTPS Caddy включает сам: сертификат Let's Encrypt выпустится
	# автоматически при первом обращении. Порты 80 и 443 должны быть открыты
	# (80 нужен для HTTP-проверки домена, не закрывай его).

	# Сжатие статики (HTML/CSS/JS). На WebSocket не влияет.
	encode zstd gzip

	log {
		output file /var/log/caddy/evil-cards.log {
			roll_size 10mb
			roll_keep 3
		}
	}

	# Собственно проксирование на контейнер игры (127.0.0.1:3000).
	#
	#  >>> WebSocket Caddy проксирует САМ. <<<
	#  Никаких заголовков Upgrade/Connection прописывать не нужно — в отличие
	#  от nginx, Caddy определяет апгрейд соединения и пробрасывает его
	#  прозрачно. Socket.io заработает сразу.
	reverse_proxy 127.0.0.1:3000 {
		# Caddy сам ставит X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
		# Добавляем только реальный IP клиента — пригодится в логах игры.
		header_up X-Real-IP {remote_host}

		transport http {
			dial_timeout 5s
			# 0 = без таймаута. Это КРИТИЧНО: партия идёт полтора часа,
			# и сокет игрока должен жить всё это время без разрывов.
			read_timeout 0
			write_timeout 0
		}

		# Если контейнер перезапускается — Caddy подождёт и попробует ещё раз,
		# вместо того чтобы отдать игроку 502 посреди раунда.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# ============================================================================
#  КАК ДОБАВИТЬ ЭТО К УЖЕ РАБОТАЮЩЕМУ CADDY, НЕ СЛОМАВ САЙТ
# ============================================================================
#
#  Caddy многосайтовый: один Caddyfile спокойно держит сколько угодно блоков,
#  каждый со своим доменом. Новый сайт = новый блок. Существующие блоки
#  трогать НЕ НАДО.
#
#  1) Бэкап (обязательно, 2 секунды):
#       sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%F)
#
#  2) Дописать блок В КОНЕЦ файла:
#       sudo nano /etc/caddy/Caddyfile
#     ...и вставить туда блок `109-172-94-130.sslip.io { ... }` из этого файла,
#     заменив 109.172.94.130 на реальный IP.
#
#     Единственное правило порядка: если в начале Caddyfile есть глобальный
#     блок в фигурных скобках БЕЗ имени домена (там обычно email для
#     Let's Encrypt) — он должен остаться самым первым. Наш блок именованный,
#     поэтому его место — в конце, и порядок остальных сайтов не важен.
#
#     Альтернатива поаккуратнее, если в Caddyfile уже есть строка
#     `import /etc/caddy/conf.d/*.caddy` (или похожая):
#       sudo cp Caddyfile.example /etc/caddy/conf.d/evil-cards.caddy
#     и править общий Caddyfile вообще не придётся.
#
#  3) Проверить синтаксис ДО перезапуска:
#       sudo caddy validate --config /etc/caddy/Caddyfile
#
#  4) Применить БЕЗ обрыва текущих соединений (reload, не restart!):
#       sudo systemctl reload caddy
#
#  5) Проверить:
#       curl -I https://109-172-94-130.sslip.io/health
#       sudo journalctl -u caddy -n 50 --no-pager
#
#  Откат: вернуть бэкап и снова `sudo systemctl reload caddy`.
#
#  Если Caddy на сервере НЕТ, а на 80/443 сидит nginx — ставить Caddy рядом
#  НЕЛЬЗЯ, они подерутся за порты. В этом случае используй deploy/nginx.example.conf.
