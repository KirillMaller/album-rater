# ============================================================================
#  Что НЕ класть в образ. Чем меньше контекст — тем быстрее сборка на слабом VPS.
#
#  ВАЖНО: public/ и server/ здесь НЕ упомянуты и попадают в образ — это код
#  игры, без них ничего не работает. Ничего сюда не добавляй наугад.
# ============================================================================

# Зависимости ставятся внутри образа через npm ci — локальные не нужны
# (и часто собраны под другую ОС).
node_modules
npm-debug.log*
yarn-error.log*
.npm

# Git и CI
.git
.gitignore
.github

# Тесты и боты — на сервере не гоняются
test
coverage

# Документация: ТЗ и прочее внутри контейнера не нужны
docs
deploy
*.md
!README.md

# Данные. Приезжают ТОМОМ с хоста (./data:/app/data):
#   base-prompts.txt / base-answers.txt — база карт, её кладёт человек;
#   state.json — автосохранение игры, оно всегда живёт на хосте.
# Если скопировать их в образ, они будут перекрыты томом и только запутают.
data

# Локальные настройки. Реальные переменные приходят через env_file: .env
.env
.env.*
!.env.example

# Файлы самой сборки
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
